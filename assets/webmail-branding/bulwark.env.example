# ========================================================
# Bulwark Webmail Branding Configuration (3D Lighting Pack)
# ========================================================
# Place the branding folder in your Bulwark webclient public root:
# e.g., /var/www/bulwark/public/branding/ or your Docker public mount

APP_LOGO_LIGHT_URL=/branding/png/app-logo-light.png
APP_LOGO_DARK_URL=/branding/png/app-logo-dark.png
LOGIN_LOGO_LIGHT_URL=/branding/png/login-logo-light.png
LOGIN_LOGO_DARK_URL=/branding/png/login-logo-dark.png
FAVICON_URL=/branding/ico/favicon.ico

# Proportional sizing for the login card
LOGIN_LOGO_MAX_WIDTH=180px
LOGIN_LOGO_MAX_HEIGHT=180px
